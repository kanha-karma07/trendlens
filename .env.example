# ==============================================================================
# TrendLens Environment Configuration
# NEVER commit real credentials to version control.
# ==============================================================================

# Data Mode: "demo" (sample/mock data) or "live" (market data adapter)
# NOTE: Demo mode enforces "Illustrative sample data" disclaimers everywhere.
DATA_MODE=demo

# Application & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://trendlens:trendlens@postgres:5432/trendlens
POSTGRES_USER=trendlens
POSTGRES_PASSWORD=trendlens
POSTGRES_DB=trendlens
POSTGRES_PORT=5432

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=trendlens_dev_secret_change_in_production_super_secure_key_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# Market Data Provider (Used only by background scheduler when DATA_MODE=live)
PROVIDER_API_KEY=
PROVIDER_BASE_URL=
